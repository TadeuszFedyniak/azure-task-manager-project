# Skopiuj do pliku .env i ustaw własne, silne wartości.
# DOMAIN musi wskazywać rekordem DNS A na publiczny adres VM.
DOMAIN=tasks.example.com
ACME_EMAIL=twoj-email@example.com
POSTGRES_DB=taskmanager
POSTGRES_USER=taskapp
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_VALUE
SESSION_SECRET=CHANGE_ME_USE_AT_LEAST_32_RANDOM_BYTES
COOKIE_SECURE=true
